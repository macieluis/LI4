@using ConvenienceChain.Core.Entities
@using ConvenienceChain.Core.Interfaces
@using ConvenienceChain.Web.Services
@inject INotificationService NotifSvc
@inject SessionService Session

@* Notificações disponíveis apenas para Gerente de Loja e Gestor da Cadeia *@
@if (Session.IsAuthenticated && (Session.IsGerenteLoja || Session.IsGestorCadeia))
{
    <div class="notif-wrapper">
        <button class="btn btn-link text-white position-relative p-0"
                type="button" @onclick="Toggle" title="Notificações">
            <i class="bi bi-bell fs-5"></i>
            @if (_naoLidas is not null && _naoLidas.Any())
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                      style="font-size:.6rem">
                    @_naoLidas.Count()
                </span>
            }
        </button>

        @if (_aberto)
        {
            <div class="notif-backdrop" @onclick="Fechar"></div>
            <div class="notif-popup shadow">
                <div class="notif-header">
                    <strong class="small">Notificações</strong>
                </div>

                @if (_naoLidas is null)
                {
                    <div class="notif-empty">A carregar…</div>
                }
                else if (!_naoLidas.Any())
                {
                    <div class="notif-empty">
                        <i class="bi bi-check2-circle d-block mb-1 opacity-50"></i>
                        Sem notificações novas
                    </div>
                }
                else
                {
                    @foreach (var n in _naoLidas.Take(6))
                    {
                        <button type="button" class="notif-item" @onclick="() => MarcarAsync(n.Id)">
                            <span class="notif-dot @CorTipo(n.Tipo)"></span>
                            <div class="flex-grow-1">
                                <div class="small notif-msg">@n.Mensagem</div>
                                <div class="text-muted notif-time">@n.DataHora.ToString("dd/MM HH:mm")</div>
                            </div>
                        </button>
                    }
                    @if (_naoLidas.Count() > 6)
                    {
                        <div class="notif-more">+@(_naoLidas.Count() - 6) mais</div>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private IEnumerable<Notificacao>? _naoLidas;
    private bool _aberto;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task Toggle()
    {
        _aberto = !_aberto;
        if (_aberto) await CarregarAsync();
    }

    private void Fechar() => _aberto = false;

    private async Task CarregarAsync()
    {
        if (!Session.IsAuthenticated || Session.UserId is null) return;
        _naoLidas = await NotifSvc.GetNaoLidasAsync(Session.UserId);
    }

    private async Task MarcarAsync(int id)
    {
        await NotifSvc.MarcarComoLidaAsync(id);
        await CarregarAsync();
    }

    private static string CorTipo(string tipo) => tipo switch
    {
        "Error"   => "bg-danger",
        "Warning" => "bg-warning",
        _         => "bg-info"
    };
}
